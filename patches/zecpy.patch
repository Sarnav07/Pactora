+    /// Signs and stores an exact proposal locally, without broadcasting. Recovery callers
+    /// must durably record the returned txid before calling rebroadcast_transaction.
+    fn sign_proposal<'py>(
+        &self, py: Python<'py>, proposal: Py<send::PyProposal>,
+    ) -> PyResult<Bound<'py, PyAny>> {
+        let inner = Arc::clone(&self.inner);
+        if inner.usk.is_none() {
+            return Err(WalletError::new_err("watch-only wallet cannot sign"));
+        }
+        pyo3_async_runtimes::tokio::future_into_py(py, async move {
+            let mut db = inner.db.lock().await;
+            let (txid, _) = tokio::task::block_in_place(|| {
+                send::build_planned(&mut db, &inner.network,
+                    inner.usk.as_ref().expect("checked above"), &inner.path, proposal.get())
+            })?;
+            Ok(txid)
+        })
+    }
+
+    /// Broadcasts only an existing stored transaction. Never builds or signs another one.
+    fn rebroadcast_transaction<'py>(
+        &self, py: Python<'py>, txid: String,
+    ) -> PyResult<Bound<'py, PyAny>> {
+        let inner = Arc::clone(&self.inner);
+        pyo3_async_runtimes::tokio::future_into_py(py, async move {
+            let parsed = zcash_primitives::transaction::TxId::from_hex(&txid).ok_or_else(|| {
+                pyo3::exceptions::PyValueError::new_err("invalid transaction id")
+            })?;
+            let db = inner.db.lock().await;
+            let (stored_id, raw) = tokio::task::block_in_place(|| send::raw_transaction(&db, parsed))?;
+            drop(db);
+            let mut client = inner.server.connect(Purpose::Broadcast).await?;
+            send::broadcast(&mut client, raw).await?;
+            Ok(stored_id)
+        })
+    }
