+++ b/tests/test_devnet_recovery.py
@@ -0,0 +1,35 @@
+"""Native split signing/rebroadcast contract; requires the local regtest chain."""
+
+import pytest
+
+from tools.leak_audit import AuditProxy
+from zecpy import Wallet, WalletError
+
+pytestmark = pytest.mark.devnet
+
+
+async def test_sign_locally_then_reopen_and_rebroadcast(tmp_path, devnet):
+    audit = AuditProxy("127.0.0.1:0", "127.0.0.1:19067", log_path=tmp_path / "audit.jsonl")
+    await audit.start()
+    try:
+        sender, _ = await Wallet.create(tmp_path / "sender", network="regtest",
+                                       server=audit.url, regtest_heights=devnet.heights)
+        receiver, _ = await Wallet.create(tmp_path / "receiver", network="regtest",
+                                         server=devnet.server, regtest_heights=devnet.heights)
+        devnet.pay(sender.address(), 2_000_000)
+        devnet.mine(10)
+        await sender.sync()
+        proposal = sender.propose(receiver.address(), 300_000)
+        before = len(audit.records)
+        txid = await sender.sign_proposal(proposal)
+        assert len(audit.records) == before, "signing must not contact the server"
+        assert receiver.balance().total == 0
+        reopened = Wallet.open(sender.path, server=audit.url)  # watch-only recovery needs no key
+        assert await reopened.rebroadcast_transaction(txid) == txid
+        devnet.mine(1)
+        await receiver.sync()
+        assert receiver.balance().total == 300_000
+        with pytest.raises((ValueError, WalletError)):
+            await reopened.rebroadcast_transaction("invalid")
+    finally:
+        await audit.stop()
diff --git a/tests/test_devnet_mandates.py b/tests/test_devnet_mandates.py
new file mode 100644
index 0000000..f747290
--- /dev/null
+++ b/tests/test_devnet_mandates.py
@@ -0,0 +1,52 @@
+"""Native Pactora mandate test. Requires installed Pactora, ZecPy and local devnet."""
+import secrets
+import time
+
+import pytest
+from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
+
+from zecpy import Wallet
+
+pytestmark = pytest.mark.devnet
+
+
+async def test_native_mandate_two_shielded_receipts(tmp_path, devnet):
+    pytest.importorskip("pactora.wallet_service")
+    from pactora.crypto import b64, canonical
+    from pactora.engine import Refused
+    from pactora.mandates import product_key
+    from pactora.wallet_service import PaymentBinding, WalletService
+
+    sender, _ = await Wallet.create(tmp_path / "sender", network="regtest",
+        server=devnet.server, regtest_heights=devnet.heights)
+    receiver, _ = await Wallet.create(tmp_path / "receiver", network="regtest",
+        server=devnet.server, regtest_heights=devnet.heights)
+    devnet.pay(sender.address(), 2_000_000)
+    devnet.mine(10)
+    await sender.sync()
+    key = Ed25519PrivateKey.generate()
+    service = WalletService(sender, tmp_path / "service", b64(secrets.token_bytes(32)),
+        b64(key.public_key().public_bytes_raw()), 1_000_000)
+    ref = secrets.token_urlsafe(24)
+    doc = {"domain": "pactora-mandate-v1", "reference": ref, "version": 1,
+        "wallet_id": "test-wallet", "network": "regtest", "merchant": "regtest-shop",
+        "eligible": [product_key("test-product", "one")], "per_purchase_cents": 100,
+        "total_cents": 200, "per_purchase_zat": 350000, "total_zat": 700000,
+        "max_purchases": 2, "expires_at": int(time.time())+600}
+    service.mandates.install(doc, b64(key.sign(canonical(doc))))
+    try:
+        for index in range(2):
+            bound = PaymentBinding(merchant="regtest-shop", invoice=f"invoice-{index}",
+                product="test-product", destination=receiver.address(), network="regtest",
+                amount_zat=300000, max_debit_zat=350000, expires_at=int(time.time())+300)
+            result = await service.purchase_under_mandate(ref, str(index), bound, "one", 100,
+                                                         bound.expires_at)
+            assert result["state"] == "broadcast"
+            devnet.mine(10)
+            await receiver.sync()
+            assert receiver.balance().total == 300000 * (index+1)
+        with pytest.raises(Refused):
+            await service.purchase_under_mandate(ref, "third", bound, "one", 100,
+                                                 bound.expires_at)
+    finally:
+        service.close()
